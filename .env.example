# Copy to .env (never commit it). The app refuses to start without POSTGRES_PASSWORD and JWT_SECRET.
POSTGRES_PASSWORD=
# At least 32 random characters, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
API_PORT=8127
WEB_PORT=8128
APP_URL=https://hrl-books.hardbanrecordslab.online
PUBLIC_REGISTRATION=false

# Transactional mail: home.pl mailbox no-reply@ (password lives on the VPS in /root/secrets).
SMTP_HOST=poczta2663497.home.pl
SMTP_PORT=587
SMTP_USER=no-reply@hardbanrecordslab.online
SMTP_PASSWORD=
SENDER_EMAIL=no-reply@hardbanrecordslab.online
GELATO_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AI assistant (OpenRouter; requests use provider.data_collection=deny)
OPENROUTER_API_KEY=
LLM_MODEL=deepseek/deepseek-chat-v3-0324
LLM_MODEL_FALLBACK=meta-llama/llama-3.3-70b-instruct

# Google Books API (search/import of published titles) — Google Cloud console, enable "Books API"
GOOGLE_BOOKS_API_KEY=
